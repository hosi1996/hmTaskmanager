# ─────────── hmTaskManager — تنظیمات ───────────
# install.sh این فایل را به‌صورت خودکار به .env تبدیل و مقادیر محرمانه را تولید می‌کند.

# ── دامنه و آدرس ──
DOMAIN=carable.hmoazzne.ir                 # ساب‌دامین پروژه
APP_URL=https://carable.hmoazzne.ir        # آدرس کامل (برای لینک‌های اعلان و تلگرام)
COOKIE_SECURE=true                         # با HTTPS باید true باشد
FRONTEND_PORT=3110                         # پورت محلی فرانت (فقط 127.0.0.1)
BACKEND_PORT=3111                          # پورت محلی بک‌اند (فقط 127.0.0.1)

# ── دیتابیس PostgreSQL (روی خود سرور) ──
DB_MODE=native                             # native | docker | managed (install.sh تشخیص می‌دهد)
PG_CONTAINER=                              # نام کانتینر پستگرس (اگر داکری است)
DB_HOST=host.docker.internal               # هاست دیتابیس از دید کانتینرها
DB_PORT=5432
DB_NAME=hmtm                               # نام دیتابیس اختصاصی پروژه
DB_USER=hmtm                               # یوزر اختصاصی پروژه
DB_PASS=change-me                          # رمز یوزر دیتابیس (خودکار تولید می‌شود)

# ── حساب مالک (فقط در اولین راه‌اندازی ساخته می‌شود) ──
OWNER_USERNAME=admin                       # نام کاربری مالک سیستم
OWNER_PASSWORD=                            # رمز اولیه؛ خالی = تصادفی (در لاگ بک‌اند چاپ می‌شود)
OWNER_NAME=مدیر سیستم                      # نام نمایشی مالک

# ── تلگرام ──
TELEGRAM_BOT_TOKEN=                        # توکن بات از @BotFather (خالی = بات غیرفعال)
BOT_INTERNAL_TOKEN=change-me               # توکن ارتباط داخلی بات و بک‌اند (خودکار تولید می‌شود)

# ── فایل‌ها ──
MAX_UPLOAD_MB=20                           # حداکثر حجم هر فایل (مگابایت)
ALLOWED_UPLOAD_TYPES=image/*,application/pdf,text/plain,application/zip,application/msword,application/vnd.openxmlformats-officedocument.*,application/vnd.ms-excel  # نوع‌های مجاز (MIME)

# ── امنیت ──
SESSION_TTL_DAYS=14                        # مدت اعتبار نشست ورود (روز)
LOGIN_MAX_FAILS=5                          # تعداد تلاش ناموفق قبل از قفل
LOGIN_LOCK_MINUTES=15                      # مدت قفل حساب (دقیقه)
RATE_LIMIT_MAX=300                         # حداکثر درخواست در دقیقه برای هر IP

# ── لاگ ──
LOG_LEVEL=info                             # debug | info | warn | error

# ── بک‌آپ ──
BACKUP_DIR=/var/backups/hmtm               # مسیر ذخیره‌ی بک‌آپ‌ها
BACKUP_KEEP_DAYS=14                        # تعداد روزهایی که بک‌آپ نگه داشته می‌شود
